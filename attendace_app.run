#!/bin/bash
# ==============================
# Attendance Portal Installer
# ==============================

APP_NAME="Attendance Portal"
APP_EXECUTABLE="attendace_app"
ICON_NAME="attendace_app"
ICON_FILE_NAME="$ICON_NAME.png"
APP_ICON_SOURCE_PATH="logo.png"
DESKTOP_FILE="$HOME/.local/share/applications/$APP_NAME.desktop"
DEST_DIR="$HOME/$APP_EXECUTABLE"
ICON_DEST_PATH="$HOME/.local/share/icons/$ICON_FILE_NAME"

# Embedded Base64 Zip
ZIP_FILE_BASE64=""

echo "$ZIP_FILE_BASE64" | base64 -d > /tmp/flutter_app_release.zip
mkdir -p "$DEST_DIR"
unzip -o /tmp/flutter_app_release.zip -d "$DEST_DIR"

mkdir -p "$HOME/.local/share/icons"
cp "$DEST_DIR/bundle/$APP_ICON_SOURCE_PATH" "$ICON_DEST_PATH"

if [ -f "$DESKTOP_FILE" ]; then rm "$DESKTOP_FILE"; fi

cat <<EOL > "$DESKTOP_FILE"
[Desktop Entry]
Version=1.0
Type=Application
Name=$APP_NAME
Exec=$DEST_DIR/bundle/$APP_EXECUTABLE
Icon=$ICON_DEST_PATH
Terminal=false
Categories=Utility;Application;
StartupWMClass=$APP_EXECUTABLE
EOL

chmod +x "$DESKTOP_FILE"
update-desktop-database ~/.local/share/applications/ 2>/dev/null || true

echo "✅ $APP_NAME installed successfully!"
